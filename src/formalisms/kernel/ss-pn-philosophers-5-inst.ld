// ---- a state of the dinner's space — ss-pn-philosophers-5-inst:
//      s1 poses only its delta (philo1.think1 = 2) — the delta's
//      member CITES the template by the path crossing the dinner's
//      citation (same path as the generated member): the marking it
//      overrides exists upstream, in the template. The other
//      markings are read at the dinner's addresses, inherited through
//      the state type. b1: a binding — its transition is the dinner's
//      philo1.take1, generated by the citation, bound late. Explicit
//      refines: the main space does not play desugaring (pushing the
//      collection's type into each child would give the same
//      closure).
layer ss-pn-philosophers-5-inst refines @ss-pn-philosophers-5
  extend states
    s1 refines @petrinet-statespace/specification/state_type
      extend places
        extend philo1.think1 refines @pn-philosophers-5/philosophes/philo1/places/think1
          override marking = 2
  extend alphabet
    b1 refines @petrinet-statespace/behavior/specification/binding_type
      transition = @petrinet-statespace/petrinet/transitions/philo1.take1

{
  "name": "layered-data-atelier",
  "version": "2.25.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bench": "node --expose-gc benchmarks/kernel.mts",
    "test": "npm run test:specification && npm run test:staging && npm run test:pen-loop && npm run test:editor && npm run test:pages && npm run test:model-editor && npm run test:editor-session && npm run test:i18n && npm run i18n:check && npm run test:stream && npm run test:perf && npm run test:validation-session && npm run test:vscode && npm run test:server && npm run test:reviewer && npm run test:error-boundary && npm run test:access-code-consent && npm run test:user-account && npm run test:rate-limit && npm run test:postgres",
    "test:reviewer": "node tests/reviewer-checks.mts",
    "test:error-boundary": "node tests/error-boundary-checks.mts",
    "test:access-code-consent": "node tests/access-code-consent-checks.mts",
    "test:user-account": "node tests/user-account-checks.mts",
    "test:rate-limit": "node tests/rate-limit-checks.mts",
    "test:coverage": "c8 --all --check-coverage --lines 80 --include='src/domain/**' --include='src/application/**' --reporter=lcov --reporter=text-summary npm test",
    "test:specification": "node tests/specification-properties.mts",
    "test:staging": "node tests/staging-checks.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:structure": "node scripts/cli.mjs check-structure src/App.tsx src/presentation/*.tsx src/pages/*.tsx src/WorkshopContainer.tsx",
    "verify": "npm run typecheck && npm run check:structure && npm run lint && npm run test:coverage && npm run build",
    "serve": "node scripts/cli.mjs serve",
    "serve:prod": "node server.ts",
    "test:pen-loop": "node tests/pen-loop-checks.mts",
    "test:editor": "node tests/editor-checks.mts",
    "test:pages": "node tests/pages-checks.mts",
    "test:model-editor": "node tests/model-editor-checks.mts",
    "test:editor-session": "node tests/editor-session-checks.mts",
    "test:i18n": "node tests/i18n-checks.mts",
    "i18n:extract": "npx i18next-parser && node scripts/i18n-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:stream": "node tests/validation-stream-checks.mts",
    "test:perf": "node tests/perf-checks.mts",
    "test:validation-session": "node tests/validation-session-checks.mts",
    "test:vscode": "node tests/vscode-checks.mts",
    "test:server": "node tests/server-http-checks.mts",
    "test:e2e": "playwright test",
    "lint": "eslint src server tests e2e --no-warn-ignored",
    "lint:fix": "eslint src server tests e2e --no-warn-ignored --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.mts\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.mts\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "test:postgres": "node tests/postgres-store-checks.mts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "i18next": "^27.1.0",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "i18next-parser": "^9.0.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.1.11",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  }
}

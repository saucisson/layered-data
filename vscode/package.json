{
  "name": "layered-data",
  "displayName": "Layered Data",
  "description": "Syntax highlighting, corpus linting and autocompletion for the .ld layer language: indentation blocks, refines acts, @layer/path addresses.",
  "version": "0.3.0",
  "publisher": "saucisson",
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.63.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:layered-data"
  ],
  "contributes": {
    "languages": [
      {
        "id": "layered-data",
        "aliases": [
          "Layered Data",
          "ld"
        ],
        "extensions": [
          ".ld"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "layered-data",
        "scopeName": "source.layered-data",
        "path": "./syntaxes/ld.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "layered-data.lint",
        "title": "Layered Data: Lint the corpus"
      }
    ],
    "configuration": {
      "title": "Layered Data",
      "properties": {
        "layered-data.nodePath": {
          "type": "string",
          "default": "node",
          "description": "The Node binary that runs the linter (needs native type stripping, 22.18+) — the same runtime as the repo harnesses."
        },
        "layered-data.language": {
          "type": "string",
          "default": "fr",
          "enum": [
            "fr",
            "en"
          ],
          "description": "The language of the verdict messages the linter renders."
        }
      }
    }
  }
}

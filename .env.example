# port d'écoute de l'armoire (server.ts) — 8791 par défaut
PORT=8791
# adresse d'écoute : 127.0.0.1 par défaut (loopback seul) ;
# mettre 0.0.0.0 seulement derrière un reverse-proxy authentifié
HOST=127.0.0.1
# jeton bearer de l'API (obligatoire — changez-le)
API_TOKEN=changez-moi
# clé Mistral pour POST /api/generate (la plume IA) ;
# absente : /api/generate répond 500 sans jamais appeler l'extérieur
MISTRAL_API_KEY=
# modèle de la plume
MISTRAL_MODEL=codestral-latest
# nombre maximum de propositions jugées par la boucle vérifiée de
# la plume (POST /api/generate) avant de répondre 422 — 3 par défaut
PEN_MAX_ATTEMPTS=3
# bras strict de la boucle (ADR-0100) : 1 = la plume ne peut pas
# proposer une lecture tranchée par l'ordre des refines entre
# sources incomparables, sauf si l'adresse lisante signe un « assume »
# (refus « conflit-d'ordre ») — 0 par défaut
PEN_STRICT_CONFLICTS=0
# bras strict de la boucle pour les checks portés (ADR-0101) : 1 = la
# plume ne peut plus proposer une couche dont les contraintes portées
# refusent (exécution des checks sur la candidate, refus
# « check-trahi ») — 0 par défaut
PEN_STRICT_CHECKS=0
# base PostgreSQL (rate limiting partagé entre instances, formalismes
# et modèles utilisateurs) — absente : le rate limiting est désactivé.
# Hors docker, pointez DATABASE_URL vers votre instance ; avec
# docker compose (issue #110), elle est câblée automatiquement sur le
# service postgres à partir des trois variables ci-dessous.
#DATABASE_URL=postgres://user:password@127.0.0.1:5432/layered_data
# docker compose : identifiants du service postgres (obligatoires avec
# compose — le schéma est initialisé au premier démarrage)
#POSTGRES_USER=layered_data
#POSTGRES_PASSWORD=changez-moi
#POSTGRES_DB=layered_data
# limites du rate limiting (fenêtre fixe par clé cliente) — 60s, 10/min
# pour /api/generate, 30/min pour les autres POST /api
#RATE_LIMIT_WINDOW_SECONDS=60
#GENERATE_MAX_REQUESTS=10
#POST_MAX_REQUESTS=30
# journal de la session éditeur en PostgreSQL (ADR-0111) : nombre de
# versions acceptées conservées pour l'undo/redo après rechargement —
# 200 par défaut
#EDITOR_SESSION_HISTORY_DEPTH=200

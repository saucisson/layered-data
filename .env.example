# port d'écoute de l'armoire (server.ts) — 8791 par défaut
PORT=8791
# adresse d'écoute : 127.0.0.1 par défaut (loopback seul) ;
# mettre 0.0.0.0 seulement derrière un reverse-proxy authentifié
HOST=127.0.0.1
# jeton bearer de l'API (obligatoire — changez-le)
API_TOKEN=changez-moi
# clé Mistral pour POST /api/generate (la plume IA) ;
# absente : /api/generate répond 500 sans jamais appeler l'extérieur
MISTRAL_API_KEY=
# modèle de la plume
MISTRAL_MODEL=codestral-latest
# nombre maximum de propositions jugées par la boucle vérifiée de
# la plume (POST /api/generate) avant de répondre 422 — 3 par défaut
PEN_MAX_ATTEMPTS=3
